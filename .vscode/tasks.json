{
  // Comandi di Unicare per VS Code.
  // Avvio di tutto: Ctrl+Shift+B  (oppure Terminal > Run Build Task...)
  // Altri comandi: Ctrl+Shift+P > "Tasks: Run Task"
  "version": "2.0.0",
  // Su Windows usiamo il Prompt dei comandi (cmd), così "mvnw.cmd" e "&&" funzionano sempre.
  "windows": {
    "options": {
      "shell": { "executable": "cmd.exe", "args": ["/d", "/c"] }
    }
  },
  "tasks": [
    {
      "label": "Avvia Unicare",
      "detail": "Database, poi backend, poi frontend",
      "dependsOn": ["1. Database", "2. Backend", "3. Frontend"],
      "dependsOrder": "sequence",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "1. Database",
      "detail": "Avvia PostgreSQL con Docker (Docker Desktop deve essere aperto)",
      "type": "shell",
      "command": "docker compose up -d",
      "presentation": { "panel": "dedicated", "reveal": "always" },
      "problemMatcher": []
    },
    {
      "label": "2. Backend",
      "detail": "Spring Boot su http://localhost:8080",
      "type": "shell",
      "command": "./mvnw spring-boot:run",
      "windows": { "command": "mvnw.cmd spring-boot:run" },
      "options": { "cwd": "${workspaceFolder}/backend" },
      "isBackground": true,
      "presentation": { "panel": "dedicated", "reveal": "always" },
      // VS Code aspetta questa riga prima di passare al frontend.
      "problemMatcher": {
        "owner": "unicare-backend",
        "pattern": { "regexp": "^__nessun_errore__$" },
        "background": {
          "activeBegin": true,
          "beginsPattern": "Starting UnicareApplication",
          "endsPattern": "Started UnicareApplication|APPLICATION FAILED TO START|BUILD FAILURE"
        }
      }
    },
    {
      "label": "3. Frontend",
      "detail": "React su http://localhost:5173 (la prima volta installa le librerie)",
      "type": "shell",
      "command": "npm install && npm run dev",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "presentation": { "panel": "dedicated", "reveal": "always" },
      "problemMatcher": {
        "owner": "unicare-frontend",
        "pattern": { "regexp": "^__nessun_errore__$" },
        "background": {
          "activeBegin": true,
          "beginsPattern": "unicare-frontend@",
          "endsPattern": "ready in"
        }
      }
    },
    {
      "label": "Test del backend",
      "detail": "Esegue i test automatici (database avviato, backend fermo)",
      "type": "shell",
      "command": "./mvnw test",
      "windows": { "command": "mvnw.cmd test" },
      "options": { "cwd": "${workspaceFolder}/backend" },
      "group": "test",
      "presentation": { "panel": "dedicated", "reveal": "always" },
      "problemMatcher": []
    },
    {
      "label": "Ferma database",
      "detail": "Spegne PostgreSQL (i dati restano salvati)",
      "type": "shell",
      "command": "docker compose down",
      "problemMatcher": []
    }
  ]
}
