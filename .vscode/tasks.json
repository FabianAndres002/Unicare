{
  // Comandi di Unicare per VS Code.
  // Avvio di tutto: Ctrl+Shift+B  (oppure Terminal > Run Build Task...)
  // Altri comandi: Ctrl+Shift+P > "Tasks: Run Task"
  // Serve solo Node.js (versione 22 o più recente): niente Java, niente Docker.
  "version": "2.0.0",
  // Su Windows usiamo il Prompt dei comandi (cmd), così "&&" funziona sempre.
  "windows": {
    "options": {
      "shell": { "executable": "cmd.exe", "args": ["/d", "/c"] }
    }
  },
  "tasks": [
    {
      "label": "Avvia Unicare",
      "detail": "Backend (con il database integrato), poi frontend",
      "dependsOn": ["1. Backend", "2. Frontend"],
      "dependsOrder": "sequence",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "1. Backend",
      "detail": "Node.js + Express su http://localhost:8080, con il database integrato (la prima volta installa le librerie)",
      "type": "shell",
      "command": "npm install && npm run dev",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "isBackground": true,
      "presentation": { "panel": "dedicated", "reveal": "always" },
      // VS Code aspetta la riga "in ascolto" prima di passare al frontend.
      "problemMatcher": {
        "owner": "unicare-backend",
        "pattern": { "regexp": "^__nessun_errore__$" },
        "background": {
          "activeBegin": true,
          "beginsPattern": "unicare-backend@",
          "endsPattern": "in ascolto|Error"
        }
      }
    },
    {
      "label": "2. Frontend",
      "detail": "React su http://localhost:5173 (la prima volta installa le librerie)",
      "type": "shell",
      "command": "npm install && npm run dev",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "presentation": { "panel": "dedicated", "reveal": "always" },
      "problemMatcher": {
        "owner": "unicare-frontend",
        "pattern": { "regexp": "^__nessun_errore__$" },
        "background": {
          "activeBegin": true,
          "beginsPattern": "unicare-frontend@",
          "endsPattern": "ready in"
        }
      }
    },
    {
      "label": "Prova sui telefoni",
      "detail": "Indirizzo https temporaneo (Cloudflare) per aprire Unicare sui telefoni. Prima avvia Unicare con Ctrl+Shift+B",
      "type": "shell",
      // Scarica cloudflared la prima volta. L'indirizzo https://....trycloudflare.com compare
      // nel terminale e cambia ogni volta che riavvii questo comando. Si chiude con Ctrl+C.
      "command": "npx --yes cloudflared tunnel --protocol http2 --url http://localhost:5173",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "presentation": { "panel": "dedicated", "reveal": "always" },
      "problemMatcher": []
    },
    {
      "label": "Test del backend",
      "detail": "Esegue i test automatici (ognuno con un database in memoria, i tuoi dati non si toccano)",
      "type": "shell",
      "command": "npm install && npm test",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "group": "test",
      "presentation": { "panel": "dedicated", "reveal": "always" },
      "problemMatcher": []
    }
  ]
}
