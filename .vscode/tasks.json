{
  // Comandi di Unicare per VS Code.
  // Avvio di tutto: Ctrl+Shift+B  (oppure Terminal > Run Build Task...)
  // Altri comandi: Ctrl+Shift+P > "Tasks: Run Task"
  "version": "2.0.0",
  // Su Windows usiamo il Prompt dei comandi (cmd), così "mvnw.cmd" e "&&" funzionano sempre.
  "windows": {
    "options": {
      "shell": { "executable": "cmd.exe", "args": ["/d", "/c"] }
    }
  },
  "tasks": [
    {
      "label": "Avvia Unicare",
      "detail": "Backend (con il database integrato), poi frontend",
      "dependsOn": ["1. Backend", "2. Frontend"],
      "dependsOrder": "sequence",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "1. Backend",
      "detail": "Spring Boot su http://localhost:8080, avvia anche il database",
      "type": "shell",
      "command": "./mvnw spring-boot:run",
      "windows": { "command": "mvnw.cmd spring-boot:run" },
      "options": { "cwd": "${workspaceFolder}/backend" },
      "isBackground": true,
      "presentation": { "panel": "dedicated", "reveal": "always" },
      // VS Code aspetta questa riga prima di passare al frontend.
      "problemMatcher": {
        "owner": "unicare-backend",
        "pattern": { "regexp": "^__nessun_errore__$" },
        "background": {
          "activeBegin": true,
          "beginsPattern": "Starting UnicareApplication",
          "endsPattern": "Started UnicareApplication|APPLICATION FAILED TO START|BUILD FAILURE"
        }
      }
    },
    {
      "label": "2. Frontend",
      "detail": "React su http://localhost:5173 (la prima volta installa le librerie)",
      "type": "shell",
      "command": "npm install && npm run dev",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "presentation": { "panel": "dedicated", "reveal": "always" },
      "problemMatcher": {
        "owner": "unicare-frontend",
        "pattern": { "regexp": "^__nessun_errore__$" },
        "background": {
          "activeBegin": true,
          "beginsPattern": "unicare-frontend@",
          "endsPattern": "ready in"
        }
      }
    },
    {
      "label": "Test del backend",
      "detail": "Esegue i test automatici (usano un database separato)",
      "type": "shell",
      "command": "./mvnw test",
      "windows": { "command": "mvnw.cmd test" },
      "options": { "cwd": "${workspaceFolder}/backend" },
      "group": "test",
      "presentation": { "panel": "dedicated", "reveal": "always" },
      "problemMatcher": []
    }
  ]
}
