# Copia questo file come "backend/.env" e scrivi le tue chiavi.
# Il file .env NON va su GitHub (è già escluso), perché le chiavi sono segrete.

# Interprete: chiave gratuita di DeepL (https://www.deepl.com/pro-api, piano "DeepL API Free").
# Finisce con ":fx". Senza chiave, in sviluppo si usa un servizio di prova gratuito.
DEEPL_API_KEY=

# Prova in famiglia (tunnel): se scrivi una parola qui, per registrarsi serve questo codice.
# Chi arriva dal link "Invita" non ne ha bisogno. Lascia vuoto per la registrazione libera.
CODICE_REGISTRAZIONE=
