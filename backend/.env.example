# Copia questo file come "backend/.env" e scrivi le tue chiavi.
# Il file .env NON va su GitHub (è già escluso), perché le chiavi sono segrete.

# Interprete: chiave gratuita di DeepL (https://www.deepl.com/pro-api, piano "DeepL API Free").
# Finisce con ":fx". Senza chiave, in sviluppo si usa un servizio di prova gratuito.
DEEPL_API_KEY=

# Prova in famiglia (tunnel): se scrivi una parola qui, per registrarsi serve questo codice.
# Chi arriva dal link "Invita" non ne ha bisogno. Lascia vuoto per la registrazione libera.
CODICE_REGISTRAZIONE=

# Email vere (conferma dell'email, "password dimenticata", avvisi). Senza SMTP_HOST le email
# non partono: restano come pagine nella cartella backend/.posta-locale.
# Con Gmail: attiva la verifica in due passaggi e crea una "password per le app"
# (myaccount.google.com/apppasswords). Le 16 lettere vanno solo nel tuo .env.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Con SMTP_HOST pieno, dopo la registrazione serve il codice arrivato per email.
# CONFERMA_EMAIL=0 la spegne, CONFERMA_EMAIL=1 la accende anche senza email vere.
CONFERMA_EMAIL=
